<Window x:Class="Controller_Diagnostics_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Diagnostics" Width="920" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18243A" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#F4F7FB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Controller Diagnostics" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="Find connected gamepads and inspect their device details." Foreground="#64748B" Margin="0,6,0,0" FontSize="14" />
            </StackPanel>
            <Button Grid.Column="1" Content="↻  Refresh devices" Click="Refresh_Click" Padding="16,10"
                    VerticalAlignment="Center" Background="#2563EB" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="CONNECTED CONTROLLERS" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,16" />
                    <Grid Grid.Row="1">
                        <ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged" BorderThickness="0" Background="Transparent"
                                 DisplayMemberPath="Name" />
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270">
                            <TextBlock Text="No controllers found" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="Connect a USB or Bluetooth controller, then select Refresh devices."
                                       Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24">
                <Grid>
                    <StackPanel x:Name="DetailsPanel">
                        <TextBlock Text="DEVICE DETAILS" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="DeviceName" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Type" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="DeviceKind" />
                        <TextBlock Text="Manufacturer" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Manufacturer" />
                        <TextBlock Text="Vendor ID / Product ID" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Identifiers" />
                        <TextBlock Text="Serial number" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="SerialNumber" TextWrapping="Wrap" />
                        <TextBlock Text="Device path" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="DevicePath" TextWrapping="Wrap" FontSize="11" Foreground="#475569" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionHint" Text="Select a controller to see its details."
                               Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0" Foreground="#64748B" FontSize="12" />
    </Grid>
</Window>
