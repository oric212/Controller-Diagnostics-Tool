<Window x:Class="Controller_Diagnostics_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Diagnostics" Width="1200" Height="790" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B1220" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#EAF0FA"/>
        <SolidColorBrush x:Key="Muted" Color="#93A3B9"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#151F30"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A3B9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#202C3F"/>
            <Setter Property="Foreground" Value="#EAF0FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24547A"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A4059"/></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ControlTemplate">
            <Border Background="#202C3F" CornerRadius="8" Padding="10,7" Margin="0,0,7,7" MinWidth="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#202C3F"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#176B72"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding Display}" Foreground="#AFC2D5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CONTROLLER LAB" Foreground="#4ED4CB" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Controller Diagnostics" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="Live HID input and device information" Foreground="#93A3B9" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh devices" Click="Refresh_Click" Padding="18,10" VerticalAlignment="Center"
                    Background="#286E89" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CONNECTED DEVICES" Style="{StaticResource Section}" Margin="0,0,0,16"/>
                    <Grid>
                        <ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#93A3B9" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyState" Text="No controllers found. Connect a USB or Bluetooth controller, then refresh."
                                   TextWrapping="Wrap" Foreground="#93A3B9" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SELECTED CONTROLLER" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="DeviceName" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FamilyText" Foreground="#4ED4CB" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ConfidenceText" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DeviceInfo" Foreground="#AFC2D5" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DevicePath" Foreground="#71849C" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="STICK DIAGNOSTICS" Style="{StaticResource Section}"/>
                            <TextBlock Text="Start a range test with the sticks released, then sweep them fully. Drift status is indicative, not a defect verdict."
                                       Foreground="#93A3B9" FontSize="11" Margin="0,5,0,14" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#1B293B" CornerRadius="12" Padding="16" Margin="0,0,7,0">
    <StackPanel>
        <TextBlock Text="LEFT STICK" Style="{StaticResource Section}"/>
        <TextBlock x:Name="LeftState" Text="Waiting for input" Foreground="#93A3B9" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <Canvas Width="104" Height="104" Background="#263348" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Ellipse Width="92" Height="92" Stroke="#455A71" StrokeThickness="2" Canvas.Left="6" Canvas.Top="6"/>
            <Line X1="52" Y1="6" X2="52" Y2="98" Stroke="#455A71"/>
            <Line X1="6" Y1="52" X2="98" Y2="52" Stroke="#455A71"/>
            <Ellipse x:Name="LeftZone" Width="7" Height="7" Stroke="#E9B45A" StrokeThickness="2" Canvas.Left="48.5" Canvas.Top="48.5"/>
            <Ellipse Width="4" Height="4" Fill="#93A3B9" Canvas.Left="50" Canvas.Top="50"/>
            <Ellipse x:Name="LeftDot" Width="16" Height="16" Fill="#4ED4CB" Canvas.Left="44" Canvas.Top="44"/>
        </Canvas>
        <TextBlock x:Name="LeftPosition" Text="X 0.00  Y 0.00  |  Radius 0.00" HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="LeftZoneText" Text="Dead zone 8%  |  Inside" Foreground="#AFC2D5" FontSize="12" Margin="0,12,0,0"/>
        <Slider x:Name="LeftDeadZone" Minimum="0" Maximum="0.4" Value="0.08" ValueChanged="DeadZone_Changed" Margin="0,6,0,0"/>
        <TextBlock x:Name="LeftNeutral" Text="Neutral: collecting samples" Foreground="#93A3B9" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LeftObserved" Text="Observed range: waiting" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LeftTest" Text="Range test: not started" Foreground="#AFC2D5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LeftStartButton" Content="Start range test" Tag="Left" Click="StickTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
            <Button Content="Reset" Tag="Left" Click="StickReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
        </StackPanel>
    </StackPanel>
</Border>
                                <ContentControl Grid.Column="1">
                                    <Border Background="#1B293B" CornerRadius="12" Padding="16" Margin="7,0,0,0">
    <StackPanel>
        <TextBlock Text="RIGHT STICK" Style="{StaticResource Section}"/>
        <TextBlock x:Name="RightState" Text="Waiting for input" Foreground="#93A3B9" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <Canvas Width="104" Height="104" Background="#263348" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Ellipse Width="92" Height="92" Stroke="#455A71" StrokeThickness="2" Canvas.Left="6" Canvas.Top="6"/>
            <Line X1="52" Y1="6" X2="52" Y2="98" Stroke="#455A71"/>
            <Line X1="6" Y1="52" X2="98" Y2="52" Stroke="#455A71"/>
            <Ellipse x:Name="RightZone" Width="7" Height="7" Stroke="#E9B45A" StrokeThickness="2" Canvas.Left="48.5" Canvas.Top="48.5"/>
            <Ellipse Width="4" Height="4" Fill="#93A3B9" Canvas.Left="50" Canvas.Top="50"/>
            <Ellipse x:Name="RightDot" Width="16" Height="16" Fill="#4ED4CB" Canvas.Left="44" Canvas.Top="44"/>
        </Canvas>
        <TextBlock x:Name="RightPosition" Text="X 0.00  Y 0.00  |  Radius 0.00" HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="RightZoneText" Text="Dead zone 8%  |  Inside" Foreground="#AFC2D5" FontSize="12" Margin="0,12,0,0"/>
        <Slider x:Name="RightDeadZone" Minimum="0" Maximum="0.4" Value="0.08" ValueChanged="DeadZone_Changed" Margin="0,6,0,0"/>
        <TextBlock x:Name="RightNeutral" Text="Neutral: collecting samples" Foreground="#93A3B9" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="RightObserved" Text="Observed range: waiting" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="RightTest" Text="Range test: not started" Foreground="#AFC2D5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RightStartButton" Content="Start range test" Tag="Right" Click="StickTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
            <Button Content="Reset" Tag="Right" Click="StickReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
        </StackPanel>
    </StackPanel>
</Border>
                                </ContentControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="BUTTONS &amp; D-PAD" Style="{StaticResource Section}"/>
                            <ItemsControl x:Name="ButtonControls" ItemTemplate="{StaticResource ControlTemplate}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="TRIGGERS" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="TriggerPanel"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="TriggerStartButton" Content="Start trigger test" Click="TriggerTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Reset" Click="TriggerReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
                            </StackPanel>
                            <TextBlock Text="RAW / UNIDENTIFIED CONTROLS" Style="{StaticResource Section}" Margin="0,18,0,0"/>
                            <TextBlock Text="Observed raw min/max; no role is assumed." Foreground="#93A3B9" FontSize="11" Margin="0,5,0,0"/>
                            <ItemsControl x:Name="RawControls" ItemTemplate="{StaticResource ControlTemplate}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="RECENT INPUT" Style="{StaticResource Section}"/>
                            <TextBlock Text="Meaningful changes only; latest first." Foreground="#93A3B9" FontSize="11" Margin="0,5,0,12"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="#71849C" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Control}" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#4ED4CB" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#93A3B9" FontSize="12" Margin="0,14,0,0"/>
    </Grid>
</Window>
