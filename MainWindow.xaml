<Window x:Class="Controller_Diagnostics_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Diagnostics" Width="1200" Height="790" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B1220" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#EAF0FA"/>
        <SolidColorBrush x:Key="Muted" Color="#93A3B9"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#151F30"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A3B9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#47566B" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#4ED4CB"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#202C3F"/>
            <Setter Property="Foreground" Value="#EAF0FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24547A"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A4059"/></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ControlTemplate">
            <Border CornerRadius="8" Padding="10,7" Margin="0,0,7,7" MinWidth="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#202C3F"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#176B72"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="#EAF0FA" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding Display}" Foreground="#AFC2D5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DEVICE DIAGNOSTICS" Foreground="#4ED4CB" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Controller Diagnostics" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="Inspect live input, neutral behavior, and control ranges" Foreground="#93A3B9" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ResetAllButton" Content="Reset measurements" Click="ResetMeasurements_Click" Padding="14,10" Margin="0,0,8,0" Background="#34445A"/>
                <Button x:Name="ExportButton" Content="Export report" Click="ExportReport_Click" Padding="14,10" Margin="0,0,8,0" Background="#286E89"/>
                <Button Content="Refresh devices" Click="Refresh_Click" Padding="14,10" Background="#34445A"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CONNECTED DEVICES" Style="{StaticResource Section}" Margin="0,0,0,16"/>
                    <Grid>
                        <ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding DevicePath}">
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#93A3B9" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding DevicePath}" Foreground="#71849C" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="218" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyState" Text="No controllers found. Connect a USB or Bluetooth controller, then refresh."
                                   TextWrapping="Wrap" Foreground="#93A3B9" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="DetailsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SELECTED CONTROLLER" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="DeviceName" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FamilyText" Foreground="#4ED4CB" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ConfidenceText" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DeviceInfo" Foreground="#AFC2D5" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DevicePath" Foreground="#71849C" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="CONTROLLER VIEW" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="ButtonLayoutNote" Text="Xbox-style layout; button positions are illustrative." Foreground="#93A3B9" FontSize="11" Margin="0,5,0,10"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxWidth="400">
                                <Canvas Width="440" Height="330">
                                    <TextBlock Text="LT" Canvas.Left="105" Canvas.Top="0" Foreground="#A7B4C2" FontSize="9" FontWeight="Bold"/>
                                    <Border x:Name="LayoutLTFrame" Canvas.Left="72" Canvas.Top="13" Width="80" Height="5" CornerRadius="3" Background="#56636F" ToolTip="LT: no mapped input">
                                        <Border x:Name="LayoutLTLevel" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#4ED4CB"/>
                                    </Border>
                                    <TextBlock Text="RT" Canvas.Left="316" Canvas.Top="0" Foreground="#A7B4C2" FontSize="9" FontWeight="Bold"/>
                                    <Border x:Name="LayoutRTFrame" Canvas.Left="282" Canvas.Top="13" Width="80" Height="5" CornerRadius="3" Background="#56636F" ToolTip="RT: no mapped input">
                                        <Border x:Name="LayoutRTLevel" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#4ED4CB"/>
                                    </Border>

                                    <Border x:Name="LayoutLB" Canvas.Left="67" Canvas.Top="18" Width="91" Height="45" CornerRadius="28" Background="#727980" ToolTip="LB / HID Button 5"/>
                                    <Border x:Name="LayoutRB" Canvas.Left="277" Canvas.Top="18" Width="91" Height="45" CornerRadius="28" Background="#727980" ToolTip="RB / HID Button 6"/>
                                    <Path Data="M 113,36 C 81,40 61,52 53,79 C 32,130 9,185 8,222 C 3,258 10,279 24,289 L 47,302 C 62,303 75,285 94,265 L 119,241 C 129,232 138,228 158,228 L 278,228 C 298,228 308,237 320,248 L 355,286 C 369,299 382,303 392,294 C 415,278 423,258 422,224 C 421,183 396,108 377,68 C 369,50 356,44 325,37 C 288,29 263,27 221,27 C 171,27 146,29 113,36 Z"
                                          Fill="#191B1E" Stroke="#444B54" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="198" Canvas.Top="43" Width="28" Height="28" Fill="#E7EBEE" Stroke="#78818B" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="80" Canvas.Top="74" Width="56" Height="56" Fill="#2E3136"/>
                                    <Border x:Name="LayoutLeftStickHead" Canvas.Left="84" Canvas.Top="78" Width="48" Height="48" CornerRadius="24" Background="#898F94" BorderBrush="#AFB6BC" BorderThickness="1.5" ToolTip="Left stick movement and click">
                                        <TextBlock x:Name="LayoutLeftStickText" Text="LS" Foreground="#252B31" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Canvas.Left="238" Canvas.Top="132" Width="58" Height="58" Fill="#2E3136"/>
                                    <Border x:Name="LayoutRightStickHead" Canvas.Left="242" Canvas.Top="136" Width="50" Height="50" CornerRadius="25" Background="#898F94" BorderBrush="#AFB6BC" BorderThickness="1.5" ToolTip="Right stick movement and click">
                                        <TextBlock x:Name="LayoutRightStickText" Text="RS" Foreground="#252B31" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Rectangle x:Name="LayoutDpadUp" Canvas.Left="151" Canvas.Top="143" Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="#8D9398"/>
                                    <Rectangle x:Name="LayoutDpadLeft" Canvas.Left="131" Canvas.Top="163" Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="#8D9398"/>
                                    <Rectangle x:Name="LayoutDpadRight" Canvas.Left="171" Canvas.Top="163" Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="#8D9398"/>
                                    <Rectangle x:Name="LayoutDpadDown" Canvas.Left="151" Canvas.Top="183" Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="#8D9398"/>
                                    <Rectangle Canvas.Left="151" Canvas.Top="163" Width="20" Height="20" Fill="#8D9398"/>
                                    <Ellipse x:Name="LayoutView" Canvas.Left="176" Canvas.Top="96" Width="18" Height="18" Fill="#858B91" ToolTip="View / HID Button 7 when mapped"/>
                                    <Ellipse x:Name="LayoutMenu" Canvas.Left="236" Canvas.Top="96" Width="18" Height="18" Fill="#858B91" ToolTip="Menu / HID Button 8 when mapped"/>
                                    <Border x:Name="LayoutBatteryFrame" Canvas.Left="184" Canvas.Top="257" Width="64" Height="22" CornerRadius="3" Background="#29343F" BorderBrush="#A8B0B8" BorderThickness="1.5" ToolTip="Battery percentage unavailable from this device">
                                        <Grid ClipToBounds="True">
                                            <Border x:Name="LayoutBatteryFill" HorizontalAlignment="Left" Width="0" Background="#4ED4CB"/>
                                            <TextBlock x:Name="LayoutBatteryText" Text="N/A" Foreground="#EAF0FA" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Rectangle Canvas.Left="249" Canvas.Top="263" Width="4" Height="10" Fill="#A8B0B8"/>

                                    <ItemsControl x:Name="ButtonControls">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="440" Height="330"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="25" Height="25" CornerRadius="13" Background="{Binding Accent}" ToolTip="{Binding Detail}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0.78"/>
                                                            <Setter Property="BorderBrush" Value="#1A1E24"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="#F7FAFC"/>
                                                                    <Setter Property="BorderThickness" Value="2.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Label}" Foreground="#15202A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CombinedTriggerNote" Text="LT and RT share one HID axis on this receiver; simultaneous pressure cannot be measured separately." Visibility="Collapsed" Foreground="#93A3B9" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <ItemsControl x:Name="ExtraButtons" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#657A91" BorderThickness="1.5" Margin="0,0,8,8" ToolTip="{Binding Detail}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#34475E"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#1EA8A0"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" Foreground="#F4FAFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="DIAGNOSTICS SUMMARY" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="SummaryModel" Text="No controller selected" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock x:Name="SummaryConnection" Text="Connection: No device selected" Foreground="#93A3B9" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SummaryControls" Text="Controls: Unavailable" Foreground="#AFC2D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="SummaryLeft" Text="Left stick: Unmapped" Foreground="#AFC2D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="SummaryRight" Text="Right stick: Unmapped" Foreground="#AFC2D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SummaryDeadZones" Text="Dead zones: 8% / 8%" Foreground="#AFC2D5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SummaryRanges" Text="Stick ranges: Unavailable" Foreground="#AFC2D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="SummaryTriggers" Text="Trigger ranges: Unavailable" Foreground="#AFC2D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="STICK DIAGNOSTICS" Style="{StaticResource Section}"/>
                            <TextBlock Text="Start a range test with the sticks released, then sweep them fully. Drift status is indicative, not a defect verdict."
                                       Foreground="#93A3B9" FontSize="11" Margin="0,5,0,14" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#1B293B" CornerRadius="12" Padding="16" Margin="0,0,7,0">
    <StackPanel>
        <TextBlock Text="LEFT STICK" Style="{StaticResource Section}"/>
        <TextBlock x:Name="LeftState" Text="Waiting for input" Foreground="#93A3B9" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <Canvas Width="104" Height="104" Background="#263348" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Ellipse Width="92" Height="92" Stroke="#455A71" StrokeThickness="2" Canvas.Left="6" Canvas.Top="6"/>
            <Line X1="52" Y1="6" X2="52" Y2="98" Stroke="#455A71"/>
            <Line X1="6" Y1="52" X2="98" Y2="52" Stroke="#455A71"/>
            <Ellipse x:Name="LeftZone" Width="7" Height="7" Stroke="#E9B45A" StrokeThickness="2" Canvas.Left="48.5" Canvas.Top="48.5"/>
            <Ellipse Width="4" Height="4" Fill="#93A3B9" Canvas.Left="50" Canvas.Top="50"/>
            <Ellipse x:Name="LeftDot" Width="16" Height="16" Fill="#4ED4CB" Canvas.Left="44" Canvas.Top="44"/>
        </Canvas>
        <TextBlock x:Name="LeftPosition" Text="X 0.00  Y 0.00  |  Radius 0.00" HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="LeftZoneText" Text="Dead zone 8%  |  Inside" Foreground="#AFC2D5" FontSize="12" Margin="0,12,0,0"/>
        <Slider x:Name="LeftDeadZone" Minimum="0" Maximum="0.4" Value="0.08" ValueChanged="DeadZone_Changed" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" Margin="0,6,0,0"/>
        <TextBlock x:Name="LeftNeutral" Text="Neutral: collecting samples" Foreground="#93A3B9" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LeftObserved" Text="Observed range: waiting" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LeftTest" Text="Range test: not started" Foreground="#AFC2D5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LeftStartButton" Content="Start range test" Tag="Left" Click="StickTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
            <Button Content="Reset" Tag="Left" Click="StickReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
        </StackPanel>
    </StackPanel>
</Border>
                                <ContentControl Grid.Column="1">
                                    <Border Background="#1B293B" CornerRadius="12" Padding="16" Margin="7,0,0,0">
    <StackPanel>
        <TextBlock Text="RIGHT STICK" Style="{StaticResource Section}"/>
        <TextBlock x:Name="RightState" Text="Waiting for input" Foreground="#93A3B9" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <Canvas Width="104" Height="104" Background="#263348" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Ellipse Width="92" Height="92" Stroke="#455A71" StrokeThickness="2" Canvas.Left="6" Canvas.Top="6"/>
            <Line X1="52" Y1="6" X2="52" Y2="98" Stroke="#455A71"/>
            <Line X1="6" Y1="52" X2="98" Y2="52" Stroke="#455A71"/>
            <Ellipse x:Name="RightZone" Width="7" Height="7" Stroke="#E9B45A" StrokeThickness="2" Canvas.Left="48.5" Canvas.Top="48.5"/>
            <Ellipse Width="4" Height="4" Fill="#93A3B9" Canvas.Left="50" Canvas.Top="50"/>
            <Ellipse x:Name="RightDot" Width="16" Height="16" Fill="#4ED4CB" Canvas.Left="44" Canvas.Top="44"/>
        </Canvas>
        <TextBlock x:Name="RightPosition" Text="X 0.00  Y 0.00  |  Radius 0.00" HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="RightZoneText" Text="Dead zone 8%  |  Inside" Foreground="#AFC2D5" FontSize="12" Margin="0,12,0,0"/>
        <Slider x:Name="RightDeadZone" Minimum="0" Maximum="0.4" Value="0.08" ValueChanged="DeadZone_Changed" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" Margin="0,6,0,0"/>
        <TextBlock x:Name="RightNeutral" Text="Neutral: collecting samples" Foreground="#93A3B9" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="RightObserved" Text="Observed range: waiting" Foreground="#93A3B9" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="RightTest" Text="Range test: not started" Foreground="#AFC2D5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RightStartButton" Content="Start range test" Tag="Right" Click="StickTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
            <Button Content="Reset" Tag="Right" Click="StickReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
        </StackPanel>
    </StackPanel>
</Border>
                                </ContentControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="TRIGGERS" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="TriggerPanel"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="TriggerStartButton" Content="Start trigger test" Click="TriggerTest_Click" Background="#286E89" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Reset" Click="TriggerReset_Click" Background="#34445A" Foreground="White" BorderThickness="0" Padding="10,6"/>
                            </StackPanel>
                            <TextBlock Text="RAW / UNIDENTIFIED CONTROLS" Style="{StaticResource Section}" Margin="0,18,0,0"/>
                            <TextBlock Text="Observed raw min/max; no role is assumed." Foreground="#93A3B9" FontSize="11" Margin="0,5,0,0"/>
                            <ItemsControl x:Name="RawControls" ItemTemplate="{StaticResource ControlTemplate}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="RECENT INPUT" Style="{StaticResource Section}"/>
                            <TextBlock Text="Meaningful changes only; latest first." Foreground="#93A3B9" FontSize="11" Margin="0,5,0,12"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="#71849C" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Control}" Foreground="#EAF0FA" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#4ED4CB" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#93A3B9" FontSize="12" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
</Window>
